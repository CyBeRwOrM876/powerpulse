PP_ENV=dev                 # use prod when deployed (requires PP_JWT_SECRET, disables API docs)
PP_JWT_SECRET=             # openssl rand -hex 32
PP_CORS=                   # comma separated origins, empty if the dashboard is served by the API
PP_MQTT_HOST=mosquitto
PP_MQTT_PORT=1883
PP_MQTT_TLS=0              # set 1 and port 8883 in production
PP_MQTT_USER=backend
PP_MQTT_PASS=
PP_TELEGRAM_TOKEN=
PP_TELEGRAM_CHAT=
